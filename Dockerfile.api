# ──────────────────────────────────────────────────────────────────────
# Dockerfile.api — SEC Semantic Search API
#
# Multi-stage build:
#   1. builder  — compiles Python deps (including pysqlcipher3)
#   2. runtime  — slim image with only runtime libraries
#
# GPU note: This image ships CPU-only PyTorch by default to keep the
# image small (~2 GB vs ~8 GB with CUDA).  For GPU acceleration, mount
# the NVIDIA runtime via `docker compose` (see docker-compose.yml) or
# build with --build-arg TORCH_INDEX_URL for a CUDA wheel.
#
# Model weights: pass a Hugging Face token as a BuildKit secret to bake the
# embedding model into the image, so no container downloads it at start-up:
#   docker build -f Dockerfile.api --build-arg REQUIRE_BAKED_MODEL=1 \
#     --secret id=hf_token,env=HUGGING_FACE_TOKEN .
# The token is mounted for one RUN step only and never lands in a layer or
# in `docker history`. Without the secret the model downloads on first use.
# Always pair the secret with REQUIRE_BAKED_MODEL=1: the build cache does
# not key on secrets, so a cached no-secret layer would otherwise be reused.
# ──────────────────────────────────────────────────────────────────────

# ── Stage 1: Builder ─────────────────────────────────────────────────
# Python 3.12.13 (Debian Bookworm): pysqlcipher3 uses C APIs removed in Python 3.13
# (PyObject_AsCharBuffer, _PyLong_AsInt). Python 3.12 is supported until Oct 2028.
# Pinned to patch version for reproducible, secure builds (H5 hardening).
FROM python:3.12.13-slim AS builder

# Build-time argument for PyTorch index (CPU by default)
ARG TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu

# Install build dependencies:
#   - gcc/g++ + python3-dev: compile C extensions
#   - libsqlcipher-dev: SQLCipher headers for pysqlcipher3
#   - pkg-config: locate sqlcipher during build
RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc g++ python3-dev \
        libsqlcipher-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Install Python dependencies into a virtual environment so we can
# copy only the venv to the runtime stage.
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install PyTorch first (largest dependency, cached separately)
COPY pyproject.toml ./
RUN pip install --no-cache-dir --extra-index-url "$TORCH_INDEX_URL" \
        torch>=2.10.0

# Install the project with all deps + encryption extra
COPY src/ ./src/
COPY README.md ./
RUN pip install --no-cache-dir --extra-index-url "$TORCH_INDEX_URL" \
        ".[encryption]"

# Bake the embedding model into the Hugging Face cache. Loading it once
# through sentence-transformers fetches exactly the files the runtime
# needs; the second load proves they are sufficient with the Hub offline.
# The deploy pipeline sets REQUIRE_BAKED_MODEL=1 because the Cloud Run
# manifest runs with HF_HUB_OFFLINE=1 and cannot download at runtime.
ARG EMBEDDING_MODEL_NAME=google/embeddinggemma-300m
ARG REQUIRE_BAKED_MODEL=0
ENV HF_HOME=/opt/hf
RUN --mount=type=secret,id=hf_token \
    mkdir -p "$HF_HOME/hub" && \
    if [ -s /run/secrets/hf_token ]; then \
        HF_TOKEN="$(cat /run/secrets/hf_token)" python -c \
            "import sys; from sentence_transformers import SentenceTransformer as M; M(sys.argv[1], device='cpu')" \
            "$EMBEDDING_MODEL_NAME" && \
        HF_HUB_OFFLINE=1 python -c \
            "import sys; from sentence_transformers import SentenceTransformer as M; M(sys.argv[1], device='cpu')" \
            "$EMBEDDING_MODEL_NAME"; \
    elif [ "$REQUIRE_BAKED_MODEL" = "1" ]; then \
        echo "REQUIRE_BAKED_MODEL=1 but no hf_token build secret was supplied." >&2; \
        exit 1; \
    else \
        echo "No hf_token build secret; the model will download on first use."; \
    fi


# ── Stage 2: Runtime ─────────────────────────────────────────────────
FROM python:3.12.13-slim AS runtime

# Runtime dependencies:
#   libsqlcipher1 — SQLCipher shared library (Debian Trixie)
#   gosu          — privilege drop in entrypoint (chown volumes then exec as app)
RUN apt-get update && apt-get install -y --no-install-recommends \
        libsqlcipher1 gosu \
    && rm -rf /var/lib/apt/lists/*

# Copy the pre-built virtual environment from the builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user
RUN groupadd --system app && useradd --system --gid app --create-home app

# Application directories — owned by app user
# chroma_db and sqlite are separate volume mount points (non-overlapping)
# /opt/hf is the Hugging Face cache; app must be able to write to it when
# the image was built without the model and downloads it on first use.
RUN mkdir -p /app/data/chroma_db /app/data/sqlite /app/logs /opt/hf \
    && chown -R app:app /app /opt/hf
WORKDIR /app

# Baked model weights (an empty directory when built without the secret).
# Only hub/ is copied: nothing else under HF_HOME is needed at runtime, and
# this keeps any token file or hf_xet chunk cache out of the image.
COPY --from=builder --chown=app:app /opt/hf/hub /opt/hf/hub

# Default data paths (overridable via env vars)
ENV DB_CHROMA_PATH=/app/data/chroma_db \
    DB_METADATA_DB_PATH=/app/data/sqlite/metadata.sqlite \
    LOG_FILE_PATH="" \
    HF_HOME=/opt/hf \
    API_HOST=0.0.0.0 \
    API_PORT=8000 \
    PYTHONUNBUFFERED=1

# Entrypoint: fixes volume directory ownership (chown app:app), then drops to
# the non-root 'app' user via gosu before exec-ing CMD.
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

# Health check — uses the /api/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/api/health')" || exit 1

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]

# Launch uvicorn directly (not via the sec-search-api wrapper, which
# parses CLI args we don't need in Docker).
# SECURITY: --workers 1 is required for rate limiting and ingest cooldown
# to function correctly — both use in-memory state that is not shared
# across processes.  Do not increase the worker count.
# SECURITY: --proxy-headers enables X-Forwarded-For / X-Real-IP parsing
# so that request.client.host reflects the real client IP (not the nginx
# container IP).  --forwarded-allow-ips "*" is safe because all Docker
# traffic arrives from the trusted nginx sidecar.  In Cloud Run, the
# Google Front End terminates TLS and manages the trust boundary.
CMD ["uvicorn", "sec_semantic_search.api.app:app", \
     "--host", "0.0.0.0", "--port", "8000", \
     "--workers", "1", "--log-level", "info", \
     "--proxy-headers", "--forwarded-allow-ips", "*"]
